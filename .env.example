# Nuxt frontend
NUXT_PUBLIC_API_BASE="http://localhost:8080"

# Go API
SERVER_PORT=8080
# Go API base URL
NUXT_PUBLIC_API_BASE="http://localhost:8080"
MODEL_GIN_MODE=release
# Required; no default
MODEL_DATABASE_DSN=root:123456@tcp(127.0.0.1:3306)/models?charset=utf8mb4&parseTime=True&loc=Local
MODEL_SYNC_COOLDOWN_MINUTES=10
MODEL_SYNC_CRON_MINUTES=60
MODEL_MODELS_DEV_URL=https://models.dev/api.json
# true 时允许无 Bearer 触发 POST /api/v1/sync（冷却/限流/互斥锁仍生效），
# 供页脚「刷新数据」按钮使用；false 时必须带 MODEL_API_KEYS 的 Bearer
MODEL_SYNC_PUBLIC_TRIGGER=false
# Comma-separated; when empty POST /api/v1/sync is disabled (fail closed)
MODEL_API_KEYS=key1,key2,key3
MODEL_CORS_ALLOWED_ORIGINS=http://localhost:3000
# Comma-separated CIDRs/IPs of reverse proxies to trust for X-Forwarded-For.
# Empty = trust none. Behind the k8s nginx ingress set this to the pod CIDR,
# e.g. 10.0.0.0/8 — otherwise the rate limiter sees all traffic as one IP.
MODEL_TRUSTED_PROXIES=
